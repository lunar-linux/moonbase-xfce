depends dbus-glib
depends libXi
depends intltool
depends exo
depends garcon
depends xfconf
depends libxfce4ui

optional_depends libX11 \
                 "--enable-x11" \
                 "--disable-x11" \
                 " for Xorg-based windowing systems"

optional_depends libXrandr \
                 "--enable-xrandr" \
                 "--disable-xrandr" \
                 "for X render support" \
                 "y"

optional_depends upower \
                 "--enable-upower-glib" \
                 "--disable-upower-glib" \
                 "for device power control support" \
                 "y"

optional_depends libnotify \
                 "--enable-libnotify" \
                 "--disable-libnotify" \
                 "for notification support" \
                 "y"

optional_depends colord \
                 "--enable-colord" \
                 "--disable-colord" \
                 "for colord support" \
                 "y"

optional_depends libXcursor \
                 "--enable-xcursor" \
                 "--disable-xcursor" \
                 "for X cursor support" \
                 "y"

optional_depends libinput \
                 "--enable-xorg-libinput" \
                 "--disable-xorg-libinput" \
                 "for X libinput driver support" \
                 "y"

optional_depends libxklavier \
                 "--enable-libxklavier" \
                 "--disable-libxklavier" \
                 "for keyboard layout selection support" \
                 "y"

optional_depends libcanberra \
                 "--enable-sound-settings" \
                 "--disable-sound-settings" \
                 "for sound control" \
                 "y"

 optional_depends wayland \
                 "--enable-wayland" \
                 "--disable-wayland" \
                 " for Wayland-based windowing systems" \
                "n"
