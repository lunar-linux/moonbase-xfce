          MODULE=xfce4-panel-profiles
         VERSION=1.1.1
          SOURCE=$MODULE-$VERSION.tar.xz
      SOURCE_URL=https://archive.xfce.org/src/apps/${MODULE}/${VERSION%.*}/
      SOURCE_VFY=sha256:0126373a03778bb4894afa151de28d36bfc563ddab96d3bd7c63962350d34ba2
        WEB_SITE=https://docs.xfce.org/apps/xfce4-panel-profiles/start
